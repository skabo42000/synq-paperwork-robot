# Template - the real keys go in .env (not committed)
GOOGLE_API_KEY=
# A key from a SEPARATE Google account, used by this project instead of GOOGLE_API_KEY so test runs
# never eat the free daily quota of the key that backs live client chat widgets.
GOOGLE_API_KEY_DEV=
GROQ_API_KEY=
# Step 6-7 (filled in by setup; the secret must match the n8n credential "Paperwork webhook secret")
PAPERWORK_WEBHOOK_URL=
PAPERWORK_WEBHOOK_SECRET=
PAPERWORK_SHEET_ID=
# Password for the upload portal (at least 12 characters)
PORTAL_PASSWORD=
